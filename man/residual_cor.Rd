simdat <- sim_closure_unit_data(
  family    = occ(),
  n_species = 4L,
  n_sites   = 50L,
  n_visits  = 4L,
  type      = 2L
)
mod <- jsdgam(
  formula        = bf(y ~ env, p ~ tod_c),
  factor_formula = ~ -1,
  data           = simdat$data_train,
  family         = occ(),
  n_lv           = 2L,
  chains         = 2,
  silent         = 2
)

rc <- residual_cor(mod)
round(rc$cor, 2)
