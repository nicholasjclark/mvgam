                 data = closure_unit_data)
pp_check(occ_fit, type = "bars", ndraws = 200)
pp_check(occ_fit, type = "rootogram")
pp_check(occ_fit, type = "stat",
         stat = function(x) mean(x == 0))
pp_check(occ_fit, type = "resid_hist", ndraws = 8)
}

